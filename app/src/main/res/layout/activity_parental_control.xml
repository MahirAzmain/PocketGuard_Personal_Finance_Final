<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".Map.Parental_Control">

        <EditText
            android:id="@+id/child_mail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="90dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="112dp"
            android:ems="10"
            android:hint="Child Email"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/child_security"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/child_mail"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_centerInParent="true"
            android:layout_marginStart="90dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="111dp"
            android:ems="10"
            android:hint="Child Security Code"
            android:inputType="textPersonName" />

        <TextView
            android:id="@+id/child_long"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/child_security"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="82dp"
            android:textColor="@color/black"
            android:text="TextView"
            />

        <TextView
            android:id="@+id/child_lat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/child_security"
            android:layout_alignParentStart="true"
            android:layout_marginStart="61dp"
            android:layout_marginTop="30dp"
            android:textColor="@color/black"
            android:text="TextView"
            />

        <Button
            android:id="@+id/get_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/child_lat"

            android:layout_centerInParent="true"
            android:layout_marginTop="48dp"
            android:onClick="get_location"
            android:text="Get Location And Balance"
            android:textAllCaps="false" />

        <Button

            android:id="@+id/see_in_map"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/get_location"
            android:layout_centerInParent="true"
            android:layout_marginTop="5dp"
            android:onClick="show_in_map"
            android:text="Show Map"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/total_balance"
            android:layout_width="wrap_content"

            android:layout_height="wrap_content"
            android:layout_below="@+id/see_in_map"
            android:layout_centerInParent="true"
            android:layout_marginTop="25dp"

            android:text="TextView"
            android:textColor="@color/favourite_colour" />

        <TextView
            android:textColor="@color/favourite_colour"
            android:id="@+id/total_income"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_below="@+id/total_balance"
            android:layout_centerInParent="true"
            android:layout_marginTop="10dp"
            android:text="TextView" />

        <TextView
            android:textColor="@color/favourite_colour"
            android:layout_below="@+id/total_income"
            android:layout_centerInParent="true"
            android:layout_marginTop="10dp"

            android:id="@+id/total_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView" />


    </RelativeLayout>

</ScrollView>

