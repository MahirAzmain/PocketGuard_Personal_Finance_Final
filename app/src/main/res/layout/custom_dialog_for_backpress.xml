<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/relative_layout_root_No_internet"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/root_linearLayout_for_backpress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white_main"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:elevation="5dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="20dp">


        <TextView
            android:id="@+id/backpress_tv_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:text="আপনি কি এই অ্যাপ হতে বের হয়ে যেতে চান?"
            android:textColor="@color/black"
            android:textSize="20sp" />


        <LinearLayout
            android:layout_marginTop="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/no_btn_backpress"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:text="না"
                app:backgroundTint="#00C777"
                android:layout_marginRight="5dp"
                />
            <Button
                android:id="@+id/yes_btn_backpress"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:text="হ্যাঁ"
                app:backgroundTint="#0095FF"
                android:layout_marginLeft="5dp"
                />

        </LinearLayout>


    </LinearLayout>

</RelativeLayout>